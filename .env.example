# Copy to .env and fill in. Used by docker-compose.yml.
DB_USERNAME=tripnext
DB_PASSWORD=change-me

# HMAC key, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Local S3 (SeaweedFS) credentials, also used by the backend
S3_ACCESS_KEY=tripnest
S3_SECRET_KEY=change-me-min-8-chars

GOOGLE_CLIENT_ID=

# Optional host port overrides
# BACKEND_PORT=8080
# S3_PORT=8333
# REDIS_PORT=6379
# POSTGRES_PORT=5432
